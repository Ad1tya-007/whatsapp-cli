{
  "name": "@adityakul0314/wacli",
  "version": "1.0.4",
  "description": "A CLI tool to send WhatsApp messages from the terminal",
  "main": "dist/index.js",
  "bin": {
    "wacli": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "postbuild": "node -e \"require('fs').chmodSync('dist/index.js', 0o755)\"",
    "start": "ts-node src/index.ts",
    "dev": "ts-node src/index.ts",
    "prepublishOnly": "npm run build",
    "prepare": "npm run build"
  },
  "keywords": [
    "whatsapp",
    "cli",
    "whatsapp-web",
    "messaging",
    "terminal",
    "automation"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ad1tya-007/whatsapp-cli"
  },
  "bugs": {
    "url": "https://github.com/Ad1tya-007/whatsapp-cli/issues"
  },
  "homepage": "https://github.com/Ad1tya-007/whatsapp-cli#readme",
  "engines": {
    "node": ">=16.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@inquirer/select": "^1.3.3",
    "commander": "^11.1.0",
    "qrcode-terminal": "^0.12.0",
    "whatsapp-web.js": "github:lindionez/whatsapp-web.js#feat/fix-_serialized-id-fallback"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/qrcode-terminal": "^0.12.2",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  }
}
